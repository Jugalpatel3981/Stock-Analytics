# Root-level defaults used by Docker Compose.

COMPOSE_PROJECT_NAME=ai-stock-intelligence-platform

POSTGRES_DB=stock_intelligence
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Change these two if ports 3000 or 8000 are already in use on your machine.
FRONTEND_PORT=3000
BACKEND_CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
DEMO_MODE_ENABLED=true
FINNHUB_API_KEY=

NEXT_PUBLIC_MARKET_STREAM_URL=ws://localhost:8000/api/v1/market/stream
